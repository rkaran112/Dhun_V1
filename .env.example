# Copy this file to .env.local and fill in the values.

# Spotify Web API (client-credentials flow, used by /api/spotify/search).
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Supabase project (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by server-rendered pages (profile, log detail).
# Never expose this to the browser. If unset, the server falls back to the
# anon key, which is fine for local development.
SUPABASE_SERVICE_ROLE_KEY=
