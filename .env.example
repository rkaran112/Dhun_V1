# Copy to .env.local and fill in the values.

# Spotify Web API (client-credentials flow, used by /api/spotify/search)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: server-side key. lib/supabase/server.ts falls back to the anon key
# when this is unset. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
